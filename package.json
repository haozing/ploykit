{
  "name": "ploykit-v2",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haozing/ploykit.git"
  },
  "bugs": {
    "url": "https://github.com/haozing/ploykit/issues"
  },
  "homepage": "https://github.com/haozing/ploykit#readme",
  "type": "module",
  "scripts": {
    "modules:scan": "node scripts/generate-module-map.mjs",
    "modules:check": "node scripts/generate-module-map.mjs --check && node scripts/generate-llm-wiki.mjs --check && node scripts/host-boundary-check.mjs && node scripts/ploykit-module.mjs check",
    "modules:deps": "node scripts/module-deps.mjs",
    "modules:templates": "node scripts/ploykit-module.mjs templates",
    "module:create": "node scripts/ploykit-module.mjs create",
    "module:doctor": "node scripts/ploykit-module.mjs doctor",
    "module:evidence": "node scripts/module-evidence.mjs",
    "module:inspect": "node scripts/ploykit-module.mjs inspect",
    "module:service-contract": "node scripts/module-service-contract.mjs",
    "module:test": "node scripts/module-test.mjs",
    "data:plan": "node scripts/module-data.mjs plan",
    "data:generate": "node scripts/module-data.mjs generate",
    "data:migrate": "node scripts/module-data.mjs migrate",
    "data:verify": "node scripts/module-data.mjs verify",
    "data:verify-db": "node scripts/module-data.mjs verify-db",
    "data:diff": "node scripts/module-data-diff.mjs",
    "data:types": "node scripts/module-data.mjs types",
    "runtime:stores:migrate": "node scripts/runtime-stores.mjs migrate",
    "runtime:stores:verify": "node scripts/runtime-stores.mjs verify",
    "runtime:check": "tsx scripts/check-runtime.ts",
    "runtime:boundary-check": "node scripts/runtime-boundary-check.mjs",
    "check": "node scripts/checks.mjs",
    "lint": "npm run typecheck && npm run check -- docs --required && npm run modules:check",
    "format:check": "npx prettier package.json tsconfig.json .prettierrc.json .github/workflows/ci.yml --check",
    "release:local-gate": "node scripts/host-boundary-check.mjs && tsx scripts/release-candidate-gate.ts --profile local",
    "release:integration-gate": "node scripts/host-boundary-check.mjs && tsx scripts/release-candidate-gate.ts --profile integration",
    "release:maintainer-gate": "node scripts/host-boundary-check.mjs && tsx scripts/release-candidate-gate.ts --profile maintainer",
    "release:evidence": "node scripts/host-rc-evidence.mjs",
    "ops": "node scripts/ops.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "test": "node scripts/test.mjs",
    "admin:ui-gate": "node scripts/admin-ui-gate.mjs",
    "admin:mobile-handfeel": "node scripts/admin-mobile-handfeel.mjs --required",
    "admin:visual-baseline": "node scripts/admin-visual-baseline.mjs",
    "host:dev": "node scripts/host-dev.mjs",
    "host:build": "node scripts/host-build.mjs",
    "host:start": "node apps/host-next/.next/standalone/apps/host-next/server.js",
    "host:smoke": "node scripts/host-smoke.mjs",
    "host:boundary-check": "node scripts/host-boundary-check.mjs",
    "host:browser-matrix": "node scripts/host-browser-matrix.mjs",
    "host:dashboard-transition-smoke": "node scripts/host-dashboard-transition-smoke.mjs",
    "host:theme-matrix": "node scripts/host-theme-matrix.mjs",
    "host:accessibility-smoke": "node scripts/host-accessibility-smoke.mjs",
    "host:config-doctor": "tsx scripts/host-config-doctor.ts",
    "host:provider-matrix": "node scripts/host-provider-matrix.mjs",
    "host:worker": "tsx scripts/host-worker.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/postcss": "^4.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "^16.2.7",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "^8.5.15"
  },
  "overridesMeta": {
    "postcss": "Keep transitive PostCSS consumers on the patched 8.x line while Tailwind 4 uses its own PostCSS-compatible package."
  },
  "engines": {
    "node": ">=22 <26",
    "npm": ">=10"
  }
}
