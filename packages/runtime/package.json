{
  "name": "@ploykit/runtime",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "description": "渲染指令通道的同构契约（框架唯一下沉 JS 的包）：emitDirective 双端实现、routeTable 路由真源、SSR/水合入口工厂。产物为 ESM（相对导入无扩展名，消费方需经 vite/esbuild 等打包器解析）；exports 的 development 条件指向源码，供 monorepo 开发期直出消费；react 系全为 peerDependencies 不打包。",
  "keywords": ["ploykit", "ssr", "rendering", "seo"],
  "license": "ISC",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "development": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./routes": {
      "development": "./src/routes.ts",
      "types": "./dist/routes.d.ts",
      "default": "./dist/routes.js"
    },
    "./browser": {
      "development": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./server": {
      "development": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./hydrate": {
      "development": "./src/hydrate.ts",
      "types": "./dist/hydrate.d.ts",
      "default": "./dist/hydrate.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "29.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
